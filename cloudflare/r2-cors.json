{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://nodeaitry.com",
          "http://127.0.0.1:1313",
          "http://localhost:1313"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
